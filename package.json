{
  "name": "dsh-codearts-connect",
  "version": "0.8.0",
  "description": "Bring CodeArts Agent (码道) models into DeepSeek Harness through a loopback OpenAI-compatible shim.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-codearts-connect": "./bin.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "bin.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codearts",
    "huaweicloud",
    "model-provider"
  ],
  "license": "MIT",
  "scripts": {
    "pack:dist": "node scripts/pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@earendil-works/pi-ai": "^1.3.0"
  }
}
